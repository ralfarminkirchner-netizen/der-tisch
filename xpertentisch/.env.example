# XPERTENTiSCH — Beispielkonfiguration. Niemals echte Schlüssel einchecken.

# production | development | test
XT_ENV=production

# Zugangsdaten der Provider (nur serverseitig, nie im Frontend-Build).
# Alternativ lassen sie sich nach dem Start über das Zahnrad in der Oberfläche
# eintragen — dafür wird XT_ADMIN_TOKEN gebraucht.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# Zugangswort für die Einstellungsseite. Ohne dieses Wort bleibt sie gesperrt,
# damit nicht jede Person mit dem Link die Zugangsdaten ändern kann.
XT_ADMIN_TOKEN=

# Ablage der Sitzungsdaten (auf Railway ein gemountetes Volume)
XT_DB_PATH=/data/xpertentisch.sqlite3

# Grenzen
XT_REQUEST_TIMEOUT_S=120
XT_MAX_PROMPT_CHARS=20000

# Nur für Entwicklung und Tests. Im Produktionsmodus bricht der Start ab,
# wenn diese Schalter gesetzt sind.
# XT_ENV=development
# XT_ALLOW_FAKE_PROVIDERS=1
# XT_USE_FAKE_MODELS=1
